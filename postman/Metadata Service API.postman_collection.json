	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"// Replace these 4 values with your Auth0 details",
					"const tokenUrl = 'https://dev-cliw71aikgnw5d80.us.auth0.com/oauth/token';",
					"const clientId = {{auth0_client_id}};",
					"const clientSecret = {{auth0_client_secret}};",
					"const audience = {{auth0_audience}};",
					"",
					"const getTokenRequest = {",
					"    method: 'POST',",
					"    url: tokenUrl,",
					"    header: {",
					"        'Content-Type': 'application/json'",
					"    },",
					"    body: {",
					"        mode: 'raw',",
					"        raw: JSON.stringify({",
					"            client_id: clientId,",
					"            client_secret: clientSecret,",
					"            audience: audience,",
					"            grant_type: 'client_credentials'",
					"        })",
					"    }",
					"};",
					"",
					"pm.sendRequest(getTokenRequest, function (err, response) {",
					"    if (err) {",
					"        console.error(\"Token retrieval failed:\", err);",
					"    } else {",
					"        const token = response.json().access_token;",
					"        // Saves the token to a Postman variable",
					"        pm.collectionVariables.set(\"current_access_token\", token); ",
					"    }",
					"});"
				]
			}
		},
